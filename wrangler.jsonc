{
  "name": "play",
  "main": "src/cloudflare-worker.mjs",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/api/*", "/games/*"]
  },
  "durable_objects": {
    "bindings": [{"name": "ROOMS", "class_name": "GameRoom"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["GameRoom"]}]
}
